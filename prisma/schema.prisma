generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  // SaaS billing
  stripeCustomerId      String?
  plan                  String   @default("free") // free | pro | enterprise
  subscriptionStatus     String?  // active | canceled | past_due | trialing
  subscriptionEndsAt    DateTime?

  // Bring-your-own-key AI (no provider cost to the app owner)
  aiProvider   String?  // anthropic | openai | openrouter | ollama
  aiApiKey     String?  // AES-256-GCM encrypted at rest
  aiBaseUrl    String?  // e.g. http://localhost:11434/v1 (ollama), https://api.openai.com/v1
  aiModel      String?  // e.g. claude-sonnet-5, gpt-4o, llama3.3

  transactions    Transaction[]
  categories      Category[]
  labels          Label[]
  rules           Rule[]
  recommendations Recommendation[]
  plaidItems      PlaidItem[]
  stripeAccounts  StripeAccount[]
  auditLogs       AuditLog[]
  payments        Payment[]
  hiddenFees      HiddenFee[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  color       String   @default("#6366f1")
  budget      Decimal? @default(0)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules       Rule[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Label {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#22c55e")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("labels")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  merchant    String
  description String?
  amount      Decimal
  currency    String   @default("USD")
  type        String   @default("expense") // expense | income
  date        DateTime
  source      String   @default("manual") // manual | ocr | csv | email | plaid
  rawText     String?
  lineItems   String?
  tax         Decimal?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // external sync dedupe (e.g. Plaid transaction id)
  externalSource String?
  externalId     String?

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  labels      Label[]
  flags       Flag[]
  hiddenFees  HiddenFee[]

  @@unique([userId, externalSource, externalId])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@map("transactions")
}

model Flag {
  id            Int      @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ruleId        Int?
  rule          Rule?       @relation(fields: [ruleId], references: [id])
  reason        String
  severity      String   @default("info")
  createdAt     DateTime @default(now())

  @@map("flags")
}

model Rule {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  field       String
  operator    String
  value       String
  action      String   @default("flag")
  message     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  flags       Flag[]

  @@index([userId])
  @@map("rules")
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  category  String?
  potentialSavings Decimal?
  severity  String   @default("info")
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recommendations")
}

model PlaidItem {
  id             Int      @id @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId         String   @unique
  accessToken    String   // AES-256-GCM encrypted at rest
  institutionId  String?
  institutionName String?
  cursor         String?  // sync pagination cursor
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("plaid_items")
}

model StripeAccount {
  id             Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String   @unique // Stripe Connect account id (acct_...)
  accessToken     String   // AES-256-GCM encrypted at rest (refreshable)
  scope            String   @default("read_only")
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("stripe_accounts")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // user.registered | user.login | plaid.connect | stripe.connect | transaction.delete | rule.delete | billing.subscribed | ...
  targetType  String?  // transaction | category | rule | plaid_item | stripe_account | user
  targetId    String?
  meta        String?  // JSON string
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Payment {
  id                 Int      @id @default(autoincrement())
  userId              String   // sender (direction = sent) or recipient (direction = received)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction           String   // sent | received
  counterpartyUserId   String?  // the other party's user id
  amount              Decimal
  currency            String   @default("USD")
  stripeChargeId        String?
  stripeTransferId       String?
  note                String?
  status              String   @default("pending") // pending | succeeded | failed
  createdAt            DateTime @default(now())

  @@index([userId, direction])
  @@map("payments")
}

model HiddenFee {
  id              Int      @id @default(autoincrement())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId    Int
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  type             String   // subscription_creep | maintenance_fee | interest | late_fee | foreign_fee | unknown_recurring
  merchant         String
  reason           String
  estimatedMonthly  Decimal?
  detectedAt       DateTime @default(now())
  dismissed        Boolean  @default(false)

  @@unique([userId, transactionId])
  @@index([userId, dismissed])
  @@map("hidden_fees")
}
