// Production schema for Postgres (Supabase / Neon / etc.).
// To use: copy this over the active schema before deploying.
//   cp prisma/schema.postgres.prisma prisma/schema.prisma
//   prisma migrate deploy   (with DATABASE_URL pointed at Postgres)
//
// Differences from the SQLite dev schema:
//   - datasource provider = postgresql
//   - native @db.Decimal(12,2) on money fields
//   - binaryTargets include Vercel's lambda runtime

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  // SaaS billing
  stripeCustomerId      String?
  plan                  String   @default("free")
  subscriptionStatus     String?
  subscriptionEndsAt    DateTime?

  transactions    Transaction[]
  categories      Category[]
  labels          Label[]
  rules           Rule[]
  recommendations Recommendation[]
  plaidItems      PlaidItem[]
  stripeAccounts  StripeAccount[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  color       String   @default("#6366f1")
  budget      Decimal? @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules       Rule[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Label {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#22c55e")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("labels")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  merchant    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  type        String   @default("expense")
  date        DateTime
  source      String   @default("manual")
  rawText     String?
  lineItems   String?
  tax         Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // external sync dedupe (e.g. Plaid transaction id)
  externalSource String?
  externalId     String?

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  labels      Label[]
  flags       Flag[]

  @@unique([userId, externalSource, externalId])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@map("transactions")
}

model Flag {
  id            Int      @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ruleId        Int?
  rule          Rule?       @relation(fields: [ruleId], references: [id])
  reason        String
  severity      String   @default("info")
  createdAt     DateTime @default(now())

  @@map("flags")
}

model Rule {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  field       String
  operator    String
  value       String
  action      String   @default("flag")
  message     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  flags       Flag[]

  @@index([userId])
  @@map("rules")
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  category  String?
  potentialSavings Decimal? @db.Decimal(12, 2)
  severity  String   @default("info")
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recommendations")
}

model PlaidItem {
  id             Int      @id @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId         String   @unique
  accessToken    String   // AES-256-GCM encrypted at rest
  institutionId  String?
  institutionName String?
  cursor         String?  // sync pagination cursor
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("plaid_items")
}

model StripeAccount {
  id             Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String   @unique
  accessToken     String   // AES-256-GCM encrypted at rest (refreshable)
  scope            String   @default("read_only")
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("stripe_accounts")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  targetType  String?
  targetId    String?
  meta        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}
